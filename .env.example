# Copy to .env.local and fill in real values. Never commit .env.local itself
# (already gitignored via .env*).

# Anthropic Claude API key -- used for Excel ingestion, image classification,
# candidate identification, and field extraction (lib/claude.ts).
ANTHROPIC_API_KEY=

# OpenRouter API key -- only needed for the optional Gemini 2.5 Flash model
# option in the extraction model picker (lib/openrouter.ts). Leave blank if
# you don't need that option; everything else works without it.
OPENROUTER_API_KEY=

# Supabase project URL and keys.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key -- used client-side (lib/supabase-browser.ts) for direct
# browser uploads to Storage via signed URLs.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key -- SERVER-SIDE ONLY (lib/db.ts, lib/storage.ts). Never
# expose this to the browser or prefix it with NEXT_PUBLIC_; it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Not read by the app itself (no direct Postgres connection is made -- all
# DB access goes through @supabase/supabase-js) -- only needed if you connect
# to the database directly with psql/a DB client for manual inspection.
# SUPABASE_DB_PASSWORD=
